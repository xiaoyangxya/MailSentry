# Copy this file to .env and replace the examples. Never commit .env.
MAILSENTRY_PERSONAL_PASSWORD=replace-with-an-app-password

# API key for the optional Responses-compatible cloud classifier.
MAILSENTRY_CLOUD_API_KEY=replace-with-a-provider-api-key

# Comma-separated Apprise URLs. See https://appriseit.com/services/
MAILSENTRY_APPRISE_URLS=ntfys://ntfy.sh/replace-with-a-private-topic
